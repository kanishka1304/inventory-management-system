<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product - Inventory System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h3>Inventory System</h3>
    <ul>
      <li><a href="/products/dashboard">Dashboard</a></li>
      <li><a href="/products/add">Add Product</a></li>
      <li><a href="/products/list">Product List</a></li>
      <li><a href="/products/analytics">Analytics</a></li>
      <li><a href="/products/history">Stock History</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </div>
  <div class="main">
    <h1>Add Product</h1>
    <% if (message) { %>
      <div class="alert alert-error"><%= message %></div>
    <% } %>
    <div class="card">
      <form action="/products/add" method="POST">
        <div class="form-group">
          <label for="name">Name:</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="price">Price:</label>
          <input type="number" id="price" name="price" step="0.01" required>
        </div>
        <div class="form-group">
          <label for="quantity">Quantity:</label>
          <input type="number" id="quantity" name="quantity" required>
        </div>
        <div class="form-group">
          <label for="category">Category:</label>
          <input type="text" id="category" name="category" required>
        </div>
        <button type="submit" class="btn btn-primary">Add Product</button>
      </form>
    </div>
  </div>
</body>
</html>