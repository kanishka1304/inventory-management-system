<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics - Inventory System</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="sidebar">
    <h3>Inventory System</h3>
    <ul>
      <li><a href="/products/dashboard">Dashboard</a></li>
      <li><a href="/products/add">Add Product</a></li>
      <li><a href="/products/list">Product List</a></li>
      <li><a href="/products/analytics">Analytics</a></li>
      <li><a href="/products/history">Stock History</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </div>
  <div class="main">
    <h1>Analytics</h1>
    <div class="cards">
      <div class="card">
        <h3>Total Stock Value</h3>
        <p>$<%= totalValue.toFixed(2) %></p>
      </div>
      <div class="card">
        <h3>Most Stocked Product</h3>
        <p><%= mostStocked ? mostStocked.name : 'None' %> (<%= mostStocked ? mostStocked.quantity : 0 %>)</p>
      </div>
      <div class="card">
        <h3>Low Stock Count</h3>
        <p><%= lowStockCount %></p>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="categoryChart"></canvas>
    </div>
  </div>
  <script>
    const ctx = document.getElementById('categoryChart').getContext('2d');
    const categories = <%- JSON.stringify(Object.keys(categories)) %>;
    const quantities = <%- JSON.stringify(Object.values(categories)) %>;
    new Chart(ctx, {
      type: 'pie',
      data: {
        labels: categories,
        datasets: [{
          label: 'Quantity by Category',
          data: quantities,
          backgroundColor: ['#1E293B', '#6366F1', '#22C55E', '#F59E0B']
        }]
      }
    });
  </script>
</body>
</html>